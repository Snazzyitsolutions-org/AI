# CallWave API configuration
PORT=5000
NODE_ENV=development

# Browser origin that is allowed to call this API.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# Neon PostgreSQL connection string.
# Neon Console -> your project -> Connect -> copy the pooled connection string.
# Replace USER, PASSWORD, ep-xxxx and region with the values from Neon.
# Keep ?sslmode=require at the end.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL instead:
# DATABASE_URL=postgresql://postgres:your-password@localhost:5432/callwave

# Optional: SSL is auto-detected for Neon. Set this only if your provider needs it.
# DATABASE_SSL=true

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Create an OAuth 2.0 Client ID of type "Web application".
# Add http://localhost:5000/api/auth/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
